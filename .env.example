# ── Infraestrutura ─────────────────────────────────────────────
GRAFANA_PASSWORD=testloki
RABBITMQ_PASSWORD=passw123
POSTGRES_USER=admin
POSTGRES_PASSWORD=passw123
POSTGRES_DB=messages_db

# ── Payment (simulação didática) ──────────────────────────────
# Probabilidade (0.0–1.0) de o pagamento ser recusado
PAYMENT_FAILURE_RATE=0.2
# Latência artificial em ms (para demonstração de timeout/CB)
PAYMENT_LATENCY_MS=0

# ── Invoice worker (simulação de falha p/ DLQ) ────────────────
INVOICE_FAIL_RATE=0.0

# ── Latências simuladas (ms) ──────────────────────────────────
# Rede entre serviços (aplica a cada chamada HTTP síncrona)
HTTP_CALL_LATENCY_MS=20
# Processamento por requisição em cada serviço
SERVICE_PROCESSING_LATENCY_MS=10
# Delay antes o worker começar a consumir a mensagem (evidencia o outbox).
# Escalonado por serviço para os "Message received" não caírem no mesmo ms:
# invoice=CONSUME_DELAY_MS, logistics=LOGISTICS_CONSUME_DELAY_MS, warranty=WARRANTY_CONSUME_DELAY_MS
CONSUME_DELAY_MS=10
LOGISTICS_CONSUME_DELAY_MS=20
WARRANTY_CONSUME_DELAY_MS=30

# ── Observabilidade ───────────────────────────────────────────
TEMPO_ENDPOINT=http://tempo:4317